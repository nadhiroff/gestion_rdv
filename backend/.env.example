# Copiez ce fichier en .env puis remplacez les valeurs.
# Ne mettez JAMAIS de vrais mots de passe dans ce fichier : il est publié sur GitHub.
#
# Pour un déploiement Coolify/Docker, n'utilisez PAS ce fichier :
# les variables sont saisies dans l'interface Coolify. Voir le
# .env.example à la racine du projet pour la liste complète.

# --- Serveur ---
PORT=4000
FRONTEND_ORIGIN=http://localhost,http://127.0.0.1,http://localhost:5500,http://127.0.0.1:5500

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=rdv_user
DB_PASSWORD=change_moi
DB_NAME=rdv_app

# --- Sécurité admin ---
# Code admin utilisé au tout premier démarrage (si admin_code_hash est vide en base).
ADMIN_CODE=0000
# Longue chaîne aléatoire, ex : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=remplacez_par_une_longue_chaine_aleatoire

# --- Email (SMTP) ---
# Gmail : utilisez un "mot de passe d'application" (16 caractères, sans espaces).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre-adresse@gmail.com
SMTP_PASSWORD=mot_de_passe_application
MAIL_FROM="Prise de rendez-vous" <votre-adresse@gmail.com>
