# ============================================================
# Variables d'environnement pour le déploiement Coolify
# Copiez ce fichier dans Coolify : votre application → Environment Variables
# (ou utilisez "Bulk Editor" et collez le tout, puis remplacez les valeurs)
# ============================================================

# --- Domaine (optionnel grâce au trust proxy, mais recommandé) ---
# L'URL publique de votre site, ex: https://rdv.mondomaine.com
# Le same-origin est détecté automatiquement ; mettez * pour tout autoriser.
FRONTEND_ORIGIN=*

# --- Base de MySQL (service "db" du docker-compose) ---
DB_USER=rdv_user
DB_PASSWORD=un_mot_de_passe_fort_a_changer
DB_NAME=rdv_app
DB_ROOT_PASSWORD=un_autre_mot_de_passe_root_fort

# --- Sécurité admin ---
# Code utilisé UNE SEULE FOIS au premier démarrage pour initialiser
# admin_code_hash en base. C'est le code pour accéder à l'admin.
ADMIN_CODE=0000
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=remplacez_par_une_longue_chaine_aleatoire_d'au_moins_32_caracteres

# --- Email (SMTP) ---
# Gmail : "mot de passe d'application" 16 caractères SANS espaces.
# SMTP_PORT=465 → SMTP_SECURE=true ; SMTP_PORT=587 → SMTP_SECURE=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre-adresse@gmail.com
SMTP_PASSWORD=mot_de_passe_application_16_caracteres
MAIL_FROM="Prise de rendez-vous" <votre-adresse@gmail.com>
