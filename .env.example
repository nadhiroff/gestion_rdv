# ===================================================================
# Gestion de rendez-vous – variables d'environnement (Coolify)
#
# Dans Coolify : votre application → onglet « Environment Variables »
# → mode « Bulk Editor » → coller tout ce bloc → remplacer les valeurs.
# Ne jamais commiter de valeurs réelles (ce fichier reste sans secrets).
# ===================================================================

# --- Domaine / CORS ---
# Laissez * : le même domaine sert le site et l'API (pas de souci CORS).
FRONTEND_ORIGIN=*

# --- Base de données MySQL (service "db" du docker-compose) ---
DB_USER=rdv_user
DB_PASSWORD=mot_de_passe_fort_a_changer
DB_NAME=rdv_app
# Mot de passe root de MySQL (interne, jamais exposé)
DB_ROOT_PASSWORD=mot_de_passe_root_fort_a_changer

# --- Sécurité admin ---
# Code pour accéder à l'espace Administration.
# Utilisé UNE SEULE FOIS au premier démarrage pour initialiser
# admin_code_hash en base. Ensuite, changez-le depuis l'admin.
ADMIN_CODE=0000
# Clé JWT : générer une fois avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Ne plus jamais la changer.
JWT_SECRET=

# --- Email (SMTP) ---
# Gmail : utilisez un « mot de passe d'application » de 16 caractères
# SANS espaces (myaccount.google.com/apppasswords, 2FA requise).
# Port 465 → SMTP_SECURE=true ; port 587 → SMTP_SECURE=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre-adresse@gmail.com
SMTP_PASSWORD=mot_de_passe_application_16_caracteres
MAIL_FROM="Prise de rendez-vous" <votre-adresse@gmail.com>
