# ===================================================================
# Gestion de rendez-vous – variables d'environnement (Coolify)
#
# Dans Coolify : votre application → onglet « Environment Variables »
# → mode « Bulk Editor » → coller tout ce bloc → remplacer les valeurs.
# Il n'y a QUE ces champs à remplir : tout le reste est en dur
# dans docker-compose.yml.
# ===================================================================

# --- Base de données MySQL (créée dans Coolify : + New › Database › MySQL) ---
# DB_HOST : nom du conteneur MySQL affiché par Coolify (réseau interne)
DB_HOST=nom-du-conteneur-mysql
DB_PORT=3306
DB_USER=votre_utilisateur_mysql
DB_PASSWORD=mot_de_passe_mysql_fort
DB_NAME=nom_de_la_base

# --- Sécurité admin ---
# Code pour accéder à l'espace Administration (ex: 0000 pour débuter)
ADMIN_CODE=0000
# Clé JWT : coller la valeur générée avec
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Ne plus jamais la changer ensuite.
JWT_SECRET=

# --- Email (SMTP) ---
# Gmail : « mot de passe d'application » 16 caractères SANS espaces
# (myaccount.google.com/apppasswords). Port 587 / secure=false en dur.
SMTP_HOST=smtp.gmail.com
SMTP_USER=ton.adresse@gmail.com
SMTP_PASSWORD=mot_de_passe_application_16_caracteres
MAIL_FROM="Prise de rendez-vous" <ton.adresse@gmail.com>
